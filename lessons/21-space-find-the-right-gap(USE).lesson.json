  "text": {
    "banner": {
      "ka": "იპოვე ხვრელი და მიაწოდე ბურთი სივრცეში",
      "en": "Find the gap and play the ball into it",
      "ru": "Найди щель и отдай в неё мяч"
    },
    "fail": {
      "cut": {
        "ka": "პასი გადაჭრეს! ბურთი მცველებს გვერდით გაატარე.",
        "en": "Cut out! Play it past the defenders, not at them.",
        "ru": "Перехват! Играй мимо защитников, а не в них."
      },
      "race": {
        "ka": "ვერ მიუსწრო! მიაწოდე იქ, სადაც ის პირველი იქნება.",
        "en": "He didn't get there first! Play it where he arrives first.",
        "ru": "Он не успел первым! Отдай туда, где он будет первым."
      },
      "line": {
        "ka": "ეს მცველების წინაა! მიაწოდე მათ ზურგს უკან.",
        "en": "That's in front of the defenders! Play it behind them.",
        "ru": "Это перед защитниками! Отдай за их спину."
      },
      "offside": {
        "ka": "ოფსაიდი! გარბენა ხაზიდან უნდა დაიწყოს.",
        "en": "Offside! The runner must start level with the line.",
        "ru": "Офсайд! Бегущий должен стартовать на уровне линии."
      }
    },
    "success": {
      "ka": "ბრწყინვალეა! #7 პირველი მივიდა ბურთთან.",
      "en": "Brilliant! #7 got to the ball first.",
      "ru": "Блестяще! #7 первым успел к мячу."
    },
    "lessonLine": {
      "ka": "იპოვე ხვრელი, სადაც ჩვენი პირველი მივა",
      "en": "Find the gap our runner wins",
      "ru": "Найди щель, где наш игрок будет первым"
    }
