      },
      "race": {
        "ka": "ვერ მიუსწრო! ბურთი იქ ჩამოაგდე, სადაც #9 პირველი იქნება.",
        "en": "He didn't get there first! Drop it where #9 wins."
      },
      "line": {
        "ka": "ეს მცველების წინაა! გადააგდე მათ თავზე, ზურგს უკან.",
        "en": "That's in front of them! Chip it over, into the space behind."
      },
      "offside": {
        "ka": "ოფსაიდი! გარბენა ხაზიდან უნდა დაიწყოს.",
